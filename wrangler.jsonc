{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chuanxiaobei-ai",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "dingbeichuan.com",
      "custom_domain": true
    }
  ]
}
